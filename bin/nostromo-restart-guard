#!/usr/bin/env bash
# Refuse a controlled nostromd restart while remote (ECS) shells are open.
#
# Used first by `make install`, `install-daemon` and `uninstall-daemon`, which
# restart the daemon: a restart ends every shell. Asks the running daemon
# through `nostromd remote-shells` (exit 0: none open, 2: no daemon running,
# 3: some open, 4: a daemon is running but gave no usable answer). Open shells
# and code 4 (and any other code) block unless FORCE=1 or
# NOSTROMO_FORCE_DAEMON_RESTART=1. Only code 2 and 0 proceed unforced. A crash
# or a raw SIGTERM cannot be guarded.
#
# Exit 0: go ahead. Exit 1: refused.
#
# NOSTROMO_RESTART_GUARD_NOSTROMD names the nostromd binary to ask (tests).
set -u

# A binary qualifies only if it knows the `remote-shells` subcommand: an older
# nostromd ignores arguments and would start a second daemon instead.
qualifies() {
  [ -x "$1" ] && grep -q "remote-shells" "$1" 2>/dev/null
}

bin=""
if [ -n "${NOSTROMO_RESTART_GUARD_NOSTROMD:-}" ]; then
  bin="$NOSTROMO_RESTART_GUARD_NOSTROMD"
else
  for candidate in "${HOME}/.local/bin/nostromd" "target/release/nostromd"; do
    if qualifies "$candidate"; then
      bin="$candidate"
      break
    fi
  done
fi

if [ -z "$bin" ]; then
  echo "restart guard: no nostromd that supports 'remote-shells' found; not checking for open remote shells" >&2
  exit 0
fi

out=$("$bin" remote-shells)
rc=$?

force=0
if [ "${FORCE:-}" = "1" ] || [ "${NOSTROMO_FORCE_DAEMON_RESTART:-}" = "1" ]; then
  force=1
fi

case "$rc" in
  0)
    exit 0
    ;;
  2)
    echo "restart guard: no daemon is running; nothing to protect." >&2
    exit 0
    ;;
  3)
    printf '%s\n' "$out"
    if [ "$force" = "1" ]; then
      echo "Remote shells are open and will be closed (forced)." >&2
      exit 0
    fi
    echo "Remote shells are open; they will be closed. Re-run with FORCE=1 to proceed." >&2
    exit 1
    ;;
  4)
    msg="restart guard: a daemon is running but could not say whether remote shells are open (it timed out, answered badly, or is too old to know the summary request)."
    if [ "$force" = "1" ]; then
      echo "$msg Proceeding (forced)." >&2
      exit 0
    fi
    echo "$msg" >&2
    echo "restart guard: the first guarded install after this guard landed is expected to hit this once: the running daemon predates the summary request. Check no remote shell matters, then re-run with FORCE=1 (or NOSTROMO_FORCE_DAEMON_RESTART=1)." >&2
    exit 1
    ;;
  *)
    if [ "$force" = "1" ]; then
      echo "restart guard: 'remote-shells' failed (exit $rc); proceeding (forced)." >&2
      exit 0
    fi
    echo "restart guard: 'remote-shells' failed (exit $rc). Re-run with FORCE=1 to proceed." >&2
    exit 1
    ;;
esac
