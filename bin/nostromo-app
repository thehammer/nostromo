#!/usr/bin/env python3
"""Drive the running Nostromo macOS app over its QA control socket.

The socket is opt-in (it can click anything in the app). Enable it with

    defaults write com.hammer.nostromo AppControlEnabled -bool true

(or launch with NOSTROMO_APP_CONTROL=1) and relaunch the app. Coordinates are
window-content points with a TOP-LEFT origin, i.e. what a screenshot shows.

    nostromo-app ping
    nostromo-app windows
    nostromo-app layout-issues [-w N]     ambiguous / zero-sized Auto Layout views
    nostromo-app ax     [CLASS-SUBSTRING]   raw accessibility tree of a (SwiftUI hosting) view
    nostromo-app activate               make the app active + window key (TAKES keyboard focus; first clicks on a non-key window are otherwise ignored)
    nostromo-app restore                hand focus back to the app that had it before `activate`
    nostromo-app tree   [-w N] [--depth D]
    nostromo-app find   TEXT [-w N]
    nostromo-app click  (--text TEXT [--index I] | X Y) [-w N] [--count C] [--mod cmd,shift]
    nostromo-app drag   (--text TEXT [--index I] | X Y) --to X Y [--steps N] [--mod cmd,shift] [-w N]   press, drag, release (select text)
    nostromo-app hittest X Y [-w N]     READ-ONLY (sends no event): which view a click at X Y hits, the view chain up to the content view
                                        (class, frame, hidden, alpha, first-responder/selectable/selection state) and key window / app active / first responder
    nostromo-app key    CHARS [--mod cmd,shift] [-w N]
    nostromo-app type   TEXT [-w N]
    nostromo-app paste  (--image PATH | --text TEXT) [-w N]
    nostromo-app drop   FILE [FILE...] (--text TEXT | --at X Y) [-w N]
    nostromo-app screenshot [PATH] [-w N]
    nostromo-app wait   TEXT [--gone] [--timeout S] [-w N]   poll until a view with TEXT appears (or vanishes); exit 1 on timeout
    nostromo-app expect TEXT [--absent] [-w N]               one-shot assertion; exit 1 if it fails
"""
import argparse, json, os, socket, sys

SOCK = os.path.expanduser("~/.nostromo/app-control.sock")
SCREEN = os.environ.get("NOSTROMO_QA_SCREEN")   # also settable via the env, for scripts


def call(req):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(20)
    try:
        s.connect(SOCK)
    except OSError as e:
        sys.exit(f"cannot reach {SOCK}: {e}\n"
                 "Is the app running with AppControlEnabled (see --help)?")
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    try:
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        sys.exit(f"timeout: no reply to {req.get('cmd')!r} within 20s.\n"
                 "The app may be parked in an AppKit mouse-tracking loop (a mouseDown on selectable\n"
                 "text or a control waiting for a mouseUp that never came), which freezes it. A REAL\n"
                 "mouse click in the app window releases it. If this was a click or drag, report it:\n"
                 "the control server is meant to queue the mouse-up itself.")
    resp = json.loads(buf)
    if not resp.get("ok"):
        sys.exit(f"error: {resp.get('error')}")
    return resp["result"]


def find_count(text, window, sheet=False):
    r = {"cmd": "find", "window": window, "text": text}
    if SCREEN:
        r["screen"] = SCREEN
    if sheet:
        r["sheet"] = True
    return len(call(r))


def wait_for(text, window, gone, timeout, sheet=False, poll=0.25):
    """True once TEXT is present (or absent, when gone) within `timeout` seconds."""
    import time
    deadline = time.time() + timeout
    while True:
        try:
            present = find_count(text, window, sheet) > 0
        except SystemExit:           # e.g. a sheet that is not (yet) attached
            present = False
        if present != gone:
            return True
        if time.time() >= deadline:
            return False
        time.sleep(poll)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-w", "--window", type=int, default=0)
    p.add_argument("--screen", help="target the window on the display whose name contains this (indices can change across relaunches)")
    p.add_argument("--sheet", action="store_true", help="target the sheet attached to the window")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("ping"); sub.add_parser("windows"); sub.add_parser("layout-issues"); sub.add_parser("activate"); sub.add_parser("restore")
    axp = sub.add_parser("ax"); axp.add_argument("cls", nargs="?", default="HostingView")
    t = sub.add_parser("tree"); t.add_argument("--depth", type=int, default=12)
    f = sub.add_parser("find"); f.add_argument("text")
    c = sub.add_parser("click"); c.add_argument("xy", nargs="*", type=float)
    c.add_argument("--text"); c.add_argument("--index", type=int, default=0)
    c.add_argument("--count", type=int, default=1); c.add_argument("--mod", default="")
    dr = sub.add_parser("drag"); dr.add_argument("xy", nargs="*", type=float)
    dr.add_argument("--text"); dr.add_argument("--index", type=int, default=0)
    dr.add_argument("--to", nargs=2, type=float, required=True, metavar=("X", "Y"))
    dr.add_argument("--steps", type=int, default=8); dr.add_argument("--mod", default="")
    ht = sub.add_parser("hittest"); ht.add_argument("xy", nargs=2, type=float, metavar=("X", "Y"))
    k = sub.add_parser("key"); k.add_argument("chars"); k.add_argument("--mod", default="")
    k.add_argument("--key-code", type=int, default=0)
    ty = sub.add_parser("type"); ty.add_argument("text")
    pa = sub.add_parser("paste"); pa.add_argument("--image"); pa.add_argument("--text")
    d = sub.add_parser("drop"); d.add_argument("files", nargs="+")
    d.add_argument("--text"); d.add_argument("--at", nargs=2, type=float)
    sc = sub.add_parser("screenshot"); sc.add_argument("path", nargs="?")
    wf = sub.add_parser("wait"); wf.add_argument("text"); wf.add_argument("--gone", action="store_true")
    wf.add_argument("--timeout", type=float, default=10.0)
    ex = sub.add_parser("expect"); ex.add_argument("text"); ex.add_argument("--absent", action="store_true")
    a = p.parse_args()
    global SCREEN
    if a.screen:
        SCREEN = a.screen

    if a.cmd == "ax":
        print(json.dumps(call({"cmd": "ax", "window": a.window, "class": a.cls}), indent=2)); return
    if a.cmd == "wait":
        ok = wait_for(a.text, a.window, a.gone, a.timeout, a.sheet)
        print(("ok: " if ok else "TIMEOUT: ") + f"{a.text!r} {'gone' if a.gone else 'present'}")
        sys.exit(0 if ok else 1)
    if a.cmd == "expect":
        present = find_count(a.text, a.window, a.sheet) > 0
        ok = present != a.absent
        print(("ok: " if ok else "FAIL: ") + f"{a.text!r} {'absent' if a.absent else 'present'}")
        sys.exit(0 if ok else 1)

    r = {"cmd": a.cmd, "window": a.window}
    if a.sheet: r["sheet"] = True
    if a.screen: r["screen"] = a.screen
    mods = [m for m in getattr(a, "mod", "").split(",") if m]
    if a.cmd == "tree": r["depth"] = a.depth
    elif a.cmd == "find": r["text"] = a.text
    elif a.cmd == "click":
        if a.text: r.update(text=a.text, index=a.index)
        elif len(a.xy) == 2: r.update(x=a.xy[0], y=a.xy[1])
        else: p.error("click needs --text or X Y")
        r.update(count=a.count, modifiers=mods)
    elif a.cmd == "drag":
        if a.text: r.update(text=a.text, index=a.index)
        elif len(a.xy) == 2: r.update(fromX=a.xy[0], fromY=a.xy[1])
        else: p.error("drag needs --text or X Y")
        r.update(toX=a.to[0], toY=a.to[1], steps=a.steps, modifiers=mods)   # the app clamps steps to 1...200
    elif a.cmd == "hittest": r.update(x=a.xy[0], y=a.xy[1])
    elif a.cmd == "key": r.update(chars=a.chars, modifiers=mods, keyCode=a.key_code)
    elif a.cmd == "type": r["text"] = a.text
    elif a.cmd == "paste":
        if a.image: r["image"] = os.path.abspath(a.image)
        elif a.text: r["text"] = a.text
        else: p.error("paste needs --image or --text")
    elif a.cmd == "drop":
        r["files"] = [os.path.abspath(x) for x in a.files]
        if a.text: r["text"] = a.text
        elif a.at: r.update(x=a.at[0], y=a.at[1])
        else: p.error("drop needs --text or --at X Y")
    elif a.cmd == "screenshot" and a.path: r["path"] = os.path.abspath(a.path)
    print(json.dumps(call(r), indent=2))


if __name__ == "__main__":
    main()
