#!/bin/sh
"exec" "python3" "-I" "$0" "$@"
"""A fake `aws` for the terminal pane's ECS tests (and the QA instance, which
passes NOSTROMO_AWS_CLI through to its daemon). It talks to nothing: Python
standard library only, no network, no credentials.

It emulates exactly what the daemon runs:

    aws sts get-caller-identity --profile P --output json
    aws ecs list-tasks    --profile P --region R --cluster C --service-name S
                          --desired-status RUNNING --output json
    aws ecs describe-tasks --profile P --region R --cluster C --tasks ARN... --output json
    aws ecs execute-command --profile P --region R --cluster C --task T
                          --container K --interactive --command SHELLCMD

Environment:
    FAKE_AWS_MODE  ok (default) | expired | no_tasks | exec_disabled |
                   plugin_missing | drop_after_connect | hang | spam
    FAKE_AWS_LOG   a file; each invocation appends its argv as one JSON line
                   (the whole sys.argv, a JSON list).
    FAKE_AWS_ENV_LOG  optional file; each invocation appends one JSON line with
                   the PATH, AWS_PAGER and TERM it was started with, and the
                   whole environment it was started with under "ENV" (a JSON
                   object), so a test can prove what the daemon did not pass on.

Any `sso` subcommand is logged and refused: the daemon must never run one.
"""

import json
import os
import signal
import sys
import time

MODE = os.environ.get("FAKE_AWS_MODE", "ok")
TASK_ARN = "arn:aws:ecs:us-east-2:123456789012:task/fake-cluster/0123456789abcdef0123456789abcdef"
SESSION = "ecs-execute-command-0123"


def append(path, line):
    if path:
        with open(path, "a") as f:
            f.write(line + "\n")


def out(text):
    sys.stdout.write(text)
    sys.stdout.flush()


def fail(message, code=254):
    sys.stderr.write(message + "\n")
    sys.stderr.flush()
    sys.exit(code)


def execute_command():
    if MODE == "plugin_missing":
        fail(
            "SessionManagerPlugin is not found. Please refer to SessionManager "
            "Documentation here: http://docs.aws.amazon.com/console/systems-manager/"
            "session-manager-plugin-not-found",
            255,
        )
    if MODE == "hang":
        signal.pause()
        sys.exit(1)
    out("\nStarting session with SessionId: %s\n" % SESSION)
    if MODE == "drop_after_connect":
        time.sleep(1)
        out("\nCannot perform start session: EOF\n")
        sys.exit(255)
    if MODE == "spam":
        while True:
            out("you said: y\n")
            time.sleep(0.001)
    while True:
        out("remote$ ")
        line = sys.stdin.readline()
        if line == "":
            sys.exit(0)
        line = line.rstrip("\r\n")
        if line.strip() == "exit":
            out("\n\nExiting session with sessionId: %s.\n" % SESSION)
            sys.exit(0)
        out("you said: %s\n" % line)


def main(argv):
    append(os.environ.get("FAKE_AWS_LOG"), json.dumps(argv))
    append(
        os.environ.get("FAKE_AWS_ENV_LOG"),
        json.dumps(
            dict(
                {k: os.environ.get(k) for k in ("PATH", "AWS_PAGER", "TERM")},
                ENV=dict(os.environ),
            )
        ),
    )
    words = [a for a in argv[1:] if not a.startswith("--")]
    if "sso" in argv[1:2]:
        fail("The daemon must never run aws sso: refused by the fake.", 1)
    if words[:2] == ["sts", "get-caller-identity"]:
        if MODE == "expired":
            fail(
                "An error occurred (ExpiredToken) when calling the GetCallerIdentity "
                "operation: The security token included in the request is expired"
            )
        out(json.dumps({"UserId": "AIDAFAKE", "Account": "123456789012",
                        "Arn": "arn:aws:iam::123456789012:user/fake"}))
    elif words[:2] == ["ecs", "list-tasks"]:
        out(json.dumps({"taskArns": [] if MODE == "no_tasks" else [TASK_ARN]}))
    elif words[:2] == ["ecs", "describe-tasks"]:
        out(json.dumps({"tasks": [{
            "taskArn": TASK_ARN,
            "lastStatus": "RUNNING",
            "enableExecuteCommand": MODE != "exec_disabled",
        }], "failures": []}))
    elif words[:2] == ["ecs", "execute-command"]:
        execute_command()
    else:
        fail("fake aws: unsupported command: %s" % " ".join(argv[1:]), 252)


if __name__ == "__main__":
    main(sys.argv)
