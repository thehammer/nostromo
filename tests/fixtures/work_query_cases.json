      "op": "group",
      "filter": {
        "sources": [
          "repo_docs"
        ],
        "kinds": [
          "bug"
        ]
      },
      "source": "repo_docs",
      "expected_groups": [
        {
          "key": "alpha",
          "ids": [
            "doc:alpha:bugs/open/2026-10-03-cafe-menu.md",
            "doc:alpha:bugs/open/2026-10-01-login-crash.md"
          ]
        },
        {
          "key": "beta",
          "ids": [
            "doc:beta:bugs/open/2026-10-02-flaky-sync.md"
          ]
        }
      ]
    },
    {
      "name": "jira groups by status category, then priority rank (none last), then most recently updated",
      "op": "group",
      "filter": {
        "sources": [
          "jira"
        ]
      },
      "source": "jira",
      "expected_groups": [
        {
          "key": "in_progress",
          "ids": [
            "jira:APP-3",
            "jira:CORE-2",
            "jira:CORE-1"
          ]
        },
        {
          "key": "to_do",
          "ids": [
            "jira:CORE-4",
            "jira:APP-5",
            "jira:CORE-7"
          ]
        },
        {
          "key": "other",
          "ids": [
            "jira:CORE-6"
          ]
        }
      ]
    },
    {
      "name": "jira grouping applies the filter first",
      "op": "group",
      "filter": {
        "sources": [
          "jira"
        ],
        "projects": [
          "CORE"
        ]
      },
      "source": "jira",
      "expected_groups": [
        {
          "key": "in_progress",
          "ids": [
            "jira:CORE-2",
            "jira:CORE-1"
          ]
        },
        {
          "key": "to_do",
          "ids": [
            "jira:CORE-4",
            "jira:CORE-7"
          ]
        },
        {
          "key": "other",
          "ids": [
            "jira:CORE-6"
          ]
        }
      ]
    },
    {
      "name": "jira groups with no items are omitted",
      "op": "group",
      "filter": {
        "sources": [
          "jira"
        ],
        "statuses": [
          "To Do"
        ]
      },
      "source": "jira",
      "expected_groups": [
        {
          "key": "to_do",
          "ids": [
            "jira:CORE-4",
            "jira:APP-5",
            "jira:CORE-7"
          ]
        }
      ]
    },
    {
      "name": "sentry is one list ordered by last seen, newest first",
      "op": "group",
      "filter": {
        "sources": [
          "sentry"
        ]
      },
      "source": "sentry",
      "expected_groups": [
        {
          "key": null,
          "ids": [
            "sentry:1002",
            "sentry:1001",
            "sentry:1003",
            "sentry:1004"
          ]
        }
      ]
    },
    {
      "name": "todos are one list ordered by priority, then due date (none last), then title",
      "op": "group",
      "filter": {
        "sources": [
          "todos"
        ]
      },
      "source": "todos",
      "expected_groups": [
        {
          "key": null,
          "ids": [
            "todo:2",
            "todo:4",
            "todo:3",
            "todo:7",
            "todo:5",
            "todo:1",
            "todo:6"
          ]
        }
      ]
    },
    {
      "name": "todos grouping applies the filter first",
      "op": "group",
      "filter": {
        "sources": [
          "todos"
        ],
        "statuses": [
          "open"
        ]
      },
      "source": "todos",
      "expected_groups": [
        {
          "key": null,
          "ids": [
            "todo:3",
            "todo:7",
            "todo:5",
            "todo:1",
            "todo:6"
          ]
        }
      ]
    },
    {
      "name": "kind chip counts ignore the kind filter itself",
      "op": "facet_counts",
      "filter": {
        "sources": [
          "repo_docs"
        ],
        "kinds": [
          "bug"
        ]
      },
      "facet": "kind",
      "expected_counts": {
        "bug": 3,
        "feature": 2,
        "wip": 1,
        "todo": 1,
        "idea": 1
      }
    },
    {
      "name": "repo chip counts ignore the repo filter but respect the others",
      "op": "facet_counts",
      "filter": {
        "sources": [
          "repo_docs"
        ],
        "kinds": [
          "bug"
        ],
        "repos": [
          "alpha"
        ]
      },
      "facet": "repo",
      "expected_counts": {
        "alpha": 2,
        "beta": 1
      }
    },
    {
      "name": "source chip counts ignore the source filter but respect the query",
      "op": "facet_counts",
      "filter": {
        "sources": [
          "jira"
        ],
        "query": "payment"
      },
      "facet": "source",
      "expected_counts": {
        "jira": 1,
        "todos": 1,
        "sentry": 1
      }
    },
    {
      "name": "status chip counts ignore the status filter but respect the project filter",
      "op": "facet_counts",
      "filter": {
        "sources": [
          "jira"
        ],
        "projects": [
          "CORE"
        ],
        "statuses": [
          "In Progress"
        ]
      },
      "facet": "status",
      "expected_counts": {
        "In Progress": 2,
        "To Do": 2,
        "Done": 1
      }
    },
    {
      "name": "environment chip counts ignore the environment filter",
      "op": "facet_counts",
      "filter": {
        "sources": [
          "sentry"
        ],
        "environments": [
          "staging"
        ]
      },
      "facet": "environment",
      "expected_counts": {
        "production": 3,
        "staging": 1
      }
    },
    {
      "name": "project counts skip items that have no project",
      "op": "facet_counts",
      "filter": {},
      "facet": "project",
      "expected_counts": {
        "CORE": 5,
        "web": 2,
        "api": 2,
        "APP": 2
      }
    },
    {
      "name": "chip counts respect the search query",
      "op": "facet_counts",
      "filter": {
        "query": "cafe"
      },
      "facet": "kind",
      "expected_counts": {
        "bug": 1,
        "task": 1,
        "todo": 1
      }
    },
    {
      "name": "chip counts respect has_severity",
      "op": "facet_counts",
      "filter": {
        "has_severity": true,
        "repos": [
          "beta"
        ]
      },
      "facet": "repo",
      "expected_counts": {
        "alpha": 2,
        "beta": 1
      }
    }
  ]
}
