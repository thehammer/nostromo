<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_nostromo._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Nostromo connects to your Nostromo server when it's on this Wi-Fi network.</string>
	<key>NSCameraUsageDescription</key>
	<string>Nostromo uses the camera only to scan the pairing code shown on your Mac.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hammer.nostromo.ios.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nostromo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
